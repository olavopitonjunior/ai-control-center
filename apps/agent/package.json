{
  "name": "@acc/agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "AI Monitor Agent — the only LAN-facing service on a monitored machine. Normalizes ccusage/Glances/scheduler data behind one authenticated API.",
  "bin": {
    "acc-agent": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@acc/adapters": "workspace:*",
    "@acc/analytics": "workspace:*",
    "@acc/protocol": "workspace:*",
    "@fastify/cors": "^10.0.1",
    "bonjour-service": "^1.3.0",
    "fastify": "^5.2.0"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  }
}
