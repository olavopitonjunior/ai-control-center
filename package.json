{
  "name": "ai-control-center",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first, touch-first AI observability appliance for the Surface Pro control plane.",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "agent:dev": "pnpm --filter @acc/agent dev",
    "surface:dev": "pnpm --filter @acc/surface dev",
    "surface:tauri": "pnpm --filter @acc/surface tauri dev"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
